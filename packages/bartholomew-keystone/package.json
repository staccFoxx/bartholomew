{
  "name": "bartholomew-keystone",
  "displayName": "Bartholomew Keystone - Capability Passkeys & Spend Governor",
  "description": "BTP v6.5.6 Cryptographically signed clearance tokens granting autonomous agents fine-grained access across files, commands, network, and spend budgets in Cursor, Claude Code, Windsurf, and VS Code.",
  "version": "6.5.6",
  "publisher": "bartholomew",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:keystone.issuePasskey",
    "onCommand:keystone.inspectClearance",
    "onCommand:keystone.revokePasskey",
    "onCommand:keystone.validateAction",
    "onCommand:keystone.auditReceipts",
    "onCommand:keystone.openDashboard"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "categories": [
    "Other",
    "Linters",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agents",
    "guardrails",
    "passkey",
    "security",
    "capabilities",
    "cursor",
    "claude",
    "claude-code",
    "copilot",
    "mcp",
    "cline",
    "windsurf",
    "aider",
    "openhands",
    "smolagents",
    "crewai",
    "spend-cap",
    "budget-governor",
    "sandbox",
    "clearance-token",
    "zero-trust",
    "open-vsx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "keystone.issuePasskey",
        "title": "Keystone: Issue Agent Capability Passkey",
        "icon": "$(key)"
      },
      {
        "command": "keystone.inspectClearance",
        "title": "Keystone: Inspect Active Agent Clearance",
        "icon": "$(shield)"
      },
      {
        "command": "keystone.revokePasskey",
        "title": "Keystone: Revoke Current Agent Passkey",
        "icon": "$(close)"
      },
      {
        "command": "keystone.validateAction",
        "title": "Keystone: Validate Agent Action against Passkey"
      },
      {
        "command": "keystone.auditReceipts",
        "title": "Keystone: View Clearance Audit Receipts"
      },
      {
        "command": "keystone.openDashboard",
        "title": "Keystone: Open Passkey Dashboard & Capability Monitor",
        "icon": "$(shield)"
      }
    ]
  },
  "scripts": {
    "compile": "node ../vscode-extension/node_modules/typescript/bin/tsc -p ./",
    "build": "node ../vscode-extension/node_modules/typescript/bin/tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ivegotahunnitonit/bartholomew.git",
    "directory": "packages/bartholomew-keystone"
  },
  "galleryBanner": {
    "color": "#0b0817",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Passkey-Cryptographic%20Clearance-blueviolet",
      "href": "https://bartholomew.info",
      "description": "Cryptographic Passkey Clearance"
    },
    {
      "url": "https://img.shields.io/badge/Spend%20Ceiling-%2425.00%20USD-success",
      "href": "https://bartholomew.info",
      "description": "Session Spend Ceiling"
    },
    {
      "url": "https://img.shields.io/badge/Verification-Sub--15%C2%B5s-brightgreen",
      "href": "https://bartholomew.info",
      "description": "HMAC-SHA256 Scope Verification"
    }
  ],
  "sponsor": {
    "url": "https://buy.stripe.com/3cI6oHbNz3LQ4U84He9R605"
  }
}