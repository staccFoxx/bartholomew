  "description": "The 1-Click Safety, Runtime Protection & Conversational Voice Coding Suite for AI Agents (Cursor, Claude Code, Copilot, Windsurf).",
  "version": "7.1.2",
  "publisher": "Bartholomew",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vscode:prepublish": "node esbuild.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "bartholomew.openSuiteHud",
        "title": "Bartholomew: Open Unified Spatial HUD Overlay"
      },
      {
        "command": "bartholomew.executeAttestedHedge",
        "title": "Bartholomew: Execute ZK-Attested Risk Hedge"
      }
    ]
  },
  "categories": [
    "Extension Packs",
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "ai",
    "agents",
    "guardrails",
    "cursor",
    "claude-code",
    "windsurf",
    "copilot",
    "mcp",
    "vault",
    "keystone",
    "zero-trust",
    "hipaa",
    "pci-dss",
    "voice",
    "voice-coding",
    "acoustic-defense",
    "autonomous-security"
  ],
  "extensionPack": [
    "Bartholomew.bartholomew-guard-vscode",
    "Bartholomew.bartholomew-keystone",
    "Bartholomew.cyphervoice-vscode",
    "Bartholomew.promptsmith-ai",
    "Bartholomew.tortuga-markets",
    "Bartholomew.bartholomew-vault"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/staccFoxx/bartholomew.git",
    "directory": "packages/bartholomew-trinity"
  },
  "galleryBanner": {
