{
  "name": "bartholomew-guard-vscode",
  "displayName": "Bartholomew Guard — AI Agent Firewall, Guardrails & Security for Cursor, Claude & Copilot",
  "description": "BTP v6.6.3 In-Process AST Guardrails, AI Agent Execution Firewall, OWASP LLM Prompt Injection & Secret Exfiltration Defense for Cursor, Claude Code, Windsurf, Copilot, and VS Code.",
  "version": "6.6.3",
  "publisher": "itsubsolomon",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "galleryBanner": {
    "color": "#070b14",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ivegotahunnitonit/bartholomew.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Machine Learning",
    "Programming Languages",
    "Testing"
  ],
  "keywords": [
    "guardrails",
    "ai-guardrails",
    "firewall",
    "ai-firewall",
    "agent-security",
    "claude-code",
    "cursor",
    "prompt-injection",
    "mcp",
    "mcp-security",
    "copilot",
    "windsurf",
    "agents",
    "security",
    "cline",
    "roo-code",
    "ast",
    "secret-scanner",
    "jailbreak-defense",
    "passkey",
    "soc2"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bartholomew.armAndLinkWorkspace",
        "title": "Bartholomew: Link & Arm Workspace (1-Click)",
        "category": "Bartholomew Guard",
        "icon": "$(zap)"
      },
      {
        "command": "bartholomew.disarmWorkspace",
        "title": "Bartholomew: Disarm Workspace (Temporary Bypass)",
        "category": "Bartholomew Guard",
        "icon": "$(shield-slash)"
      },
      {
        "command": "bartholomew.toggleArmStatus",
        "title": "Bartholomew: Toggle Arm / Disarm Protection",
        "category": "Bartholomew Guard",
        "icon": "$(shield)"
      },
      {
        "command": "bartholomew.openFeedback",
        "title": "Bartholomew: Give Feedback & Request Invariants",
        "category": "Bartholomew Guard",
        "icon": "$(feedback)"
      },
      {
        "command": "bartholomew.openEnterpriseDocs",
        "title": "Bartholomew: Open Enterprise Security Portal",
        "icon": "$(book)"
      },
      {
        "command": "bartholomew.injectAiRules",
        "title": "Bartholomew: Inject Autonomous Agent Rules (GEMINI.md, CLAUDE.md, .cursorrules)",
        "icon": "$(file-code)"
      },
      {
        "command": "bartholomew.installPreCommit",
        "title": "Bartholomew: Install Git Pre-Commit AST Hook",
        "icon": "$(git-commit)"
      },
      {
        "command": "bartholomew.protectWorkspace",
        "title": "Bartholomew: Immunize Project (btp-guard protect)",
        "icon": "$(verified)"
      },
      {
        "command": "bartholomew.copyModelContext",
        "title": "Bartholomew: Copy Agent Context (Gemini, Claude, Cursor)",
        "icon": "$(clippy)"
      },
      {
        "command": "bartholomew.openProofOfProtection",
        "title": "Bartholomew: Open Proof of Protection & Agent Bridge",
        "icon": "$(shield)"
      },
      {
        "command": "bartholomew.openCollaborationHub",
        "title": "Bartholomew: Open Ecosystem Collaboration Hub",
        "icon": "$(plug)"
      },
      {
        "command": "bartholomew.viewStatus",
        "title": "Bartholomew: View Security Status & Trust Roots",
        "icon": "$(shield)"
      },
      {
        "command": "bartholomew.issueKeystonePasskey",
        "title": "Keystone: Issue Agent Capability Passkey",
        "icon": "$(key)"
      },
      {
        "command": "bartholomew.inspectKeystoneClearance",
        "title": "Keystone: Inspect Active Agent Clearance",
        "icon": "$(shield)"
      },
      {
        "command": "bartholomew.revokeKeystonePasskey",
        "title": "Keystone: Revoke Current Agent Passkey",
        "icon": "$(close)"
      },
      {
        "command": "bartholomew.validateKeystoneAction",
        "title": "Keystone: Validate Agent Action against Passkey"
      },
      {
        "command": "bartholomew.runSwarmBenchmark",
        "title": "Bartholomew: Run Swarm Stress-Benchmark (100 Agents)",
        "icon": "$(pulse)"
      },
      {
        "command": "bartholomew.openDashboard",
        "title": "Bartholomew: Open Visual Policy Editor"
      },
      {
        "command": "bartholomew.openTelemetry",
        "title": "Bartholomew: Open Live Swarm Telemetry Vault"
      },
      {
        "command": "bartholomew.validatePolicy",
        "title": "Bartholomew: Validate & Lint Workspace Security Policy"
      },
      {
        "command": "bartholomew.dryRunTrace",
        "title": "Bartholomew: Dry-Run Policy against Synthetic Agent Trace"
      },
      {
        "command": "bartholomew.generateComplianceEvidence",
        "title": "Bartholomew: Generate Compliance Evidence Pack"
      },
      {
        "command": "bartholomew.installMcp",
        "title": "Bartholomew: Install MCP Server (Claude & Cursor)"
      },
      {
        "command": "bartholomew.runInSandbox",
        "title": "Bartholomew: Run in Kernel Sandbox",
        "category": "Bartholomew"
      },
      {
        "command": "bartholomew.exportAuditDossier",
        "title": "Bartholomew: Export Machine-Signed Compliance & EU AI Act Audit Dossier",
        "icon": "$(verified-filled)"
      },
      {
        "command": "bartholomew.harmonizeToolSchema",
        "title": "Bartholomew: Harmonize Active Tool Schema (Claude, OpenAI, Gemini, MCP)",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "bartholomew.showSecurityMenu",
        "title": "Bartholomew: Open Security Control Plane & Actions Menu",
        "icon": "$(shield)"
      },
      {
        "command": "bartholomew.runRedTeamBenchmark",
        "title": "Bartholomew: Run Red-Team Agent Fuzzing Benchmark",
        "icon": "$(beaker)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bartholomew-guard",
          "title": "Bartholomew Guard",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "bartholomew-guard": [
        {
          "type": "webview",
          "id": "bartholomew.proofView",
          "name": "Proof of Protection & Keystone Bridge"
        }
      ]
    },
    "configuration": {
      "title": "Bartholomew Agent Guard",
      "properties": {
        "bartholomew.astLatencyCeilingUs": {
          "type": "number",
          "default": 35,
          "description": "Maximum allowable in-process AST evaluation latency in microseconds."
        },
        "bartholomew.autoImmunizeWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically immunize workspace directives (.cursorrules, GEMINI.md, CLAUDE.md)."
        },
        "bartholomew.quarantineDestructiveCommands": {
          "type": "boolean",
          "default": true,
          "description": "Quarantine destructive shell commands (rm -rf, mkfs, DROP TABLE) before process binding."
        },
        "bartholomew.secretMasking": {
          "type": "boolean",
          "default": true,
          "description": "Mask high-entropy secrets and API keys (Stripe, OpenAI, AWS, GitHub) in caller memory."
        },
        "bartholomew.keystoneDailyBudgetLimit": {
          "type": "number",
          "default": 25.0,
          "description": "Daily autonomous spending cap in USD enforced via Keystone Passkeys."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.3.0"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Security-100%2F100%20(A%2B)-success",
      "href": "https://bartholomew.info",
      "description": "Security Audit Score"
    },
    {
      "url": "https://img.shields.io/badge/Invariants-15%20Pillars-blue",
      "href": "https://bartholomew.info",
      "description": "Active Security Invariants"
    },
    {
      "url": "https://img.shields.io/badge/Latency-Sub--Millisecond-brightgreen",
      "href": "https://bartholomew.info",
      "description": "Sub-Millisecond In-Process Latency"
    }
  ],
  "homepage": "https://bartholomew.info"
}