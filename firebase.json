{
  "hosting": {
    "site": "acn-26670",
    "public": "site",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/marketplace/register",
        "destination": "/marketplace/register.html"
      },
      {
        "source": "/agensi",
        "destination": "/agensi.html"
      },
      {
        "source": "/enterprise",
        "destination": "/enterprise.html"
      },
      {
        "source": "/careers",
        "destination": "/careers.html"
      },
      {
        "source": "/careers/admin",
        "destination": "/careers_admin.html"
      },
      {
        "source": "/cloud",
        "destination": "/control-plane.html"
      },
      {
        "source": "/sim",
        "destination": "/sim-lab.html"
      }
    ]
  }
}
