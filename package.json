{
  "name": "bartholomew-suite-monorepo",
  "version": "7.1.0",
  "private": true,
  "description": "Bartholomew Institutional Security, Governance & Prediction Market Toolchain",
  "workspaces": [
    "shared-ui-core",
    "packages/vscode-extension",
    "packages/bartholomew-keystone",
    "packages/promptsmith-vscode",
    "packages/bartholomew-trinity",
    "packages/bartholomew-vault"
  ],
  "scripts": {
    "dev:ui": "npm --prefix shared-ui-core run dev",
    "build:ui": "npm --prefix shared-ui-core run build",
    "sync:ui": "node scripts/sync-ui.js",
    "release:suite": "npm run build:ui && npm run sync:ui",
    "release:ui": "npm run release:suite",
    "test:keystone": "cd packages/bartholomew-keystone && node test_keystone.js",
    "package:all": "python scripts/package_all_vsix.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/staccFoxx/bartholomew.git"
  },
  "author": "staccFoxx",
  "license": "Apache-2.0"
}
